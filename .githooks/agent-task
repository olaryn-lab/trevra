#!/bin/sh
# One worktree and one agent/<id> branch per agent task. Identical in every
# Olaryn repository.
#
#   .githooks/agent-task start <id>    new worktree .worktrees/<id> on agent/<id>, from origin/main
#   .githooks/agent-task land          (inside the task worktree) rebase on origin/main, push to main
#   .githooks/agent-task finish <id>   remove a landed task's worktree and branch
#   .githooks/agent-task list          task branches, landed or not
#
# `land` pushes HEAD to main, so the pre-push gate runs on exactly what lands.
# Nothing here deletes unlanded commits, uncommitted or untracked files, or
# remote branches.
set -eu
die() { echo "agent-task: $*" >&2; exit 1; }
valid_id() { case "$1" in '' | .* | *[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }
top=$(git rev-parse --show-toplevel)
# The main checkout is always the first entry.
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
cmd=${1:-}
[ $# -eq 0 ] || shift

case "$cmd" in
start)
  id=${1:-}
  valid_id "$id" || die "usage: start <id>  (letters, digits, '.', '_', '-')"
  dir="$main/.worktrees/$id"
  [ ! -e "$dir" ] || die "$dir already exists"
  ! git show-ref --verify --quiet "refs/heads/agent/$id" || die "branch agent/$id already exists"
  git -C "$main" fetch --quiet origin main
  git -C "$main" worktree add --quiet --no-track -b "agent/$id" "$dir" origin/main
  echo "agent-task: work in $dir"
  echo "agent-task: commit, run 'make verify', then '.githooks/agent-task land'"
  ;;

land)
  [ $# -eq 0 ] || die "usage: land  (run it inside the task worktree)"
  br=$(git symbolic-ref --short -q HEAD) || die "detached HEAD: check out your agent/<id> branch"
  case "$br" in agent/*) ;; *) die "land runs on an agent/<id> branch, not $br" ;; esac
  [ -z "$(git status --porcelain)" ] || die "commit your work first: the gate checks the working tree"
  tries=0
  while :; do
    git fetch --quiet origin main
    [ "$(git rev-list --count origin/main..HEAD)" != 0 ] || { echo "agent-task: nothing to land"; exit 0; }
    git rebase --quiet origin/main ||
      die "rebase stopped on a conflict: resolve it, run 'git rebase --continue', then land again"
    git push origin HEAD:refs/heads/main && break
    # Retry only when main moved under us; a failed gate or other error stops here.
    git fetch --quiet origin main
    ! git merge-base --is-ancestor origin/main HEAD || die "push failed; read the output above"
    tries=$((tries + 1))
    [ "$tries" -lt 3 ] || die "main kept moving; tried 3 times"
    echo "agent-task: main moved, rebasing again" >&2
  done
  echo "agent-task: landed $(git rev-parse --short HEAD) on main. Next, from outside this worktree:"
  echo "  .githooks/agent-task finish ${br#agent/}"
  ;;

finish)
  id=${1:-}
  valid_id "$id" || die "usage: finish <id>"
  br="agent/$id" dir="$main/.worktrees/$id"
  git show-ref --verify --quiet "refs/heads/$br" || die "no branch $br"
  [ "$top" != "$dir" ] || die "run finish from outside $dir"
  git -C "$main" fetch --quiet origin main
  git -C "$main" merge-base --is-ancestor "$br" origin/main ||
    die "$br has commits that are not on origin/main; land them first. Nothing removed."
  if [ -e "$dir" ]; then
    # Refuses when the worktree has modified or untracked files. Ignored files
    # (dependencies, build output) are removed with it.
    git -C "$main" worktree remove "$dir" || die "$dir has uncommitted or untracked files. Nothing removed."
  fi
  # -D is safe: the ancestry check above proved every commit is on origin/main.
  git -C "$main" branch --quiet -D "$br"
  echo "agent-task: removed $br"
  ;;

list)
  git -C "$main" fetch --quiet origin main || echo "agent-task: fetch failed; showing local state" >&2
  git -C "$main" for-each-ref --format='%(refname:short)' refs/heads/agent/ | while IFS= read -r br; do
    if git merge-base --is-ancestor "$br" origin/main; then state=landed
    else state="$(git rev-list --count "origin/main..$br") commit(s) not landed"; fi
    dir="$main/.worktrees/${br#agent/}"
    [ -d "$dir" ] || dir="(no worktree)"
    echo "$br  $state  $dir"
  done
  ;;

*) die "usage: agent-task start <id> | land | finish <id> | list" ;;
esac
