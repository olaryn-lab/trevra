#!/bin/sh
# Pre-push gate. Runs each check in .githooks/verify.rules whose paths the
# pushed commits touch. This file is identical in every Olaryn repository;
# only verify.rules differs.
#
#   git push                 checks the commits being pushed
#   .githooks/pre-push       checks HEAD + uncommitted work against origin/main
#   VERIFY_ALL=1 .githooks/pre-push   runs every rule, as if every file changed
#
# Checks run in the working tree. A rule fires on any change to its paths,
# deletions included. Each command gets $VERIFY_CHANGED, a file listing the
# changed paths that still exist, one per line.
# lc-debt: checks run on the working tree, not the pushed commit's tree; push
# from a clean tree for an exact result (an isolated worktree checkout would
# need its own dependency install per push).
set -eu
cd "$(git rev-parse --show-toplevel)"
rules=.githooks/verify.rules
[ -f "$rules" ] || { echo "pre-push: $rules missing" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM
if [ -t 0 ]; then : > "$tmp/refs"; else cat > "$tmp/refs"; fi
manual=0
[ -s "$tmp/refs" ] || manual=1

# Git LFS repositories keep their pre-push upload step.
if [ "$manual" = 0 ] && grep -qs 'filter=lfs' .gitattributes; then
  command -v git-lfs >/dev/null 2>&1 || { echo "pre-push: git-lfs is required here" >&2; exit 2; }
  git lfs pre-push "$@" < "$tmp/refs"
fi

is_zero() { case "$1" in *[!0]*) return 1 ;; *) return 0 ;; esac; }
base_of() { git merge-base "$1" origin/main 2>/dev/null || git rev-list --max-parents=0 "$1" | tail -n 1; }

# One "base tip" line per pushed ref; deletions are skipped.
: > "$tmp/ranges"
while read -r _lref lsha _rref rsha; do
  [ -n "${lsha:-}" ] || continue
  case "$_lref" in refs/tags/*) continue ;; esac
  is_zero "$lsha" && continue
  if is_zero "$rsha" || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    rsha=$(base_of "$lsha")
  fi
  echo "$rsha $lsha" >> "$tmp/ranges"
  [ "$lsha" = "$(git rev-parse HEAD)" ] || echo "pre-push: warning: pushing $lsha but checks run on HEAD's working tree" >&2
done < "$tmp/refs"
[ "$manual" = 0 ] || mbase=$(base_of HEAD)
[ -z "$(git status --porcelain)" ] || echo "pre-push: note: uncommitted changes are included in the checks" >&2

# changed [pathspec...]: changed paths (deletions included), limited to the pathspecs.
changed() {
  if [ "${VERIFY_ALL:-0}" = 1 ]; then
    git ls-files -- "$@"
  elif [ "$manual" = 1 ]; then
    git diff --name-only "$mbase" -- "$@"
    git ls-files -o --exclude-standard -- "$@"
  else
    while read -r b t; do git diff --name-only "$b" "$t" -- "$@"; done < "$tmp/ranges"
  fi
}
changed . | sort -u > "$tmp/all"
if [ ! -s "$tmp/all" ]; then echo "pre-push: no changed files, nothing to check"; exit 0; fi
# Commands get only the paths that still exist; rules also fire on deletions.
while IFS= read -r f; do [ ! -e "$f" ] || echo "$f"; done < "$tmp/all" > "$tmp/changed"
export VERIFY_CHANGED="$tmp/changed"

ran=0 failed=""
set -f
while IFS= read -r line; do
  case "$line" in ''|'#'*) continue ;; esac
  specs=${line%%|*}; cmd=${line#*|}; cmd=${cmd# }
  # shellcheck disable=SC2086
  set -- $specs
  [ -n "$(changed "$@" | head -n 1)" ] || continue
  ran=$((ran + 1))
  echo "pre-push: \$ $cmd"
  if ! sh -c "$cmd" < /dev/null; then failed="$failed
  $cmd"; fi
done < "$rules"
set +f

if [ -n "$failed" ]; then
  echo "pre-push: FAILED:$failed" >&2
  echo "pre-push: fix the failures; only a person may bypass with --no-verify." >&2
  exit 1
fi
echo "pre-push: $ran check(s) passed"
